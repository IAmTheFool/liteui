{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-release-profile",
      "displayName": "MSVC Release + Profiler",
      "inherits": "msvc-release",
      "binaryDir": "${sourceDir}/build/release-profile",
      "cacheVariables": {
        "LITEUI_PROFILE": "ON"
      }
    },
    {
      "name": "msvc-debug-profile",
      "displayName": "MSVC Debug + Profiler",
      "inherits": "msvc-debug",
      "binaryDir": "${sourceDir}/build/debug-profile",
      "cacheVariables": {
        "LITEUI_PROFILE": "ON"
      }
    },
    {
      "name": "msvc-debug-asan",
      "displayName": "MSVC Debug + AddressSanitizer",
      "inherits": "msvc-debug",
      "binaryDir": "${sourceDir}/build/debug-asan",
      "cacheVariables": {
        "LITEUI_SANITIZE": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-debug-profile",
      "displayName": "GCC Debug + Profiler",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/debug-profile",
      "cacheVariables": {
        "LITEUI_PROFILE": "ON"
      }
    },
    {
      "name": "gcc-release-profile",
      "displayName": "GCC Release + Profiler",
      "inherits": "gcc-release",
      "binaryDir": "${sourceDir}/build/release-profile",
      "cacheVariables": {
        "LITEUI_PROFILE": "ON"
      }
    },
    {
      "name": "gcc-debug-asan",
      "displayName": "GCC Debug + AddressSanitizer / UBSan",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/debug-asan",
      "cacheVariables": {
        "LITEUI_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",           "configurePreset": "msvc-debug" },
    { "name": "msvc-release",         "configurePreset": "msvc-release" },
    { "name": "msvc-release-profile", "configurePreset": "msvc-release-profile" },
    { "name": "msvc-debug-profile",   "configurePreset": "msvc-debug-profile" },
    { "name": "msvc-debug-asan",      "configurePreset": "msvc-debug-asan" },
    { "name": "gcc-debug",            "configurePreset": "gcc-debug" },
    { "name": "gcc-release",          "configurePreset": "gcc-release" },
    { "name": "gcc-debug-profile",    "configurePreset": "gcc-debug-profile" },
    { "name": "gcc-release-profile",  "configurePreset": "gcc-release-profile" },
    { "name": "gcc-debug-asan",       "configurePreset": "gcc-debug-asan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120,
        "noTestsAction": "error"
      }
    },
    { "name": "msvc-debug",      "inherits": "test-base", "configurePreset": "msvc-debug" },
    { "name": "msvc-release",    "inherits": "test-base", "configurePreset": "msvc-release" },
    { "name": "msvc-debug-asan", "inherits": "test-base", "configurePreset": "msvc-debug-asan" },
    { "name": "gcc-debug",       "inherits": "test-base", "configurePreset": "gcc-debug" },
    { "name": "gcc-release",     "inherits": "test-base", "configurePreset": "gcc-release" },
    { "name": "gcc-debug-asan",  "inherits": "test-base", "configurePreset": "gcc-debug-asan" }
  ]
}